<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Existing Hello World TextView -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hello_message"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Existing button from Part 1 and Part 2 -->
    <Button
        android:id="@+id/button"
        style="@style/AssignmentButtonStyle"
        android:layout_width="wrap_content"
        android:text="@string/ButtonText"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Existing Start Chat button from Part 3 -->
    <Button
        android:id="@+id/startChatButton"
        style="@style/AssignmentButtonStyle"
        android:layout_width="wrap_content"
        android:text="@string/start_chat"
        app:layout_constraintTop_toBottomOf="@id/button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PART 4: Test Toolbar button -->
    <Button
        android:id="@+id/testToolbarButton"
        style="@style/AssignmentButtonStyle"
        android:layout_width="wrap_content"
        android:text="@string/test_toolbar"
        app:layout_constraintTop_toBottomOf="@id/startChatButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
